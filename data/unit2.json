 "grammar": [
  {
   "id": "g1",
   "title": "a / an / the (tekil isimler)",
   "tr": "Tekil sayılabilir isimlerin önünde <b>a</b> ya da <b>an</b> kullanılır: ünlü (a, e, i, o, u) sesiyle başlayan kelimelerden önce <b>an</b>, diğerlerinden önce <b>a</b>. <b>university</b>, <b>euro</b> gibi /ju:/ sesiyle başlayanlarda <b>a</b> kullanılır. Çoğul isimlerin önünde a / an kullanılmaz. Hangisi olduğunu bildiğimizde <b>the</b> kullanırız: Look at <b>the</b> board.",
   "table": {
    "head": [
     "Tekil",
     "Çoğul"
    ],
    "rows": [
     [
      "It's a book.",
      "They're books."
     ],
     [
      "It's a watch.",
      "They're watches."
     ],
     [
      "It's an umbrella.",
      "They're umbrellas."
     ],
     [
      "It's an identity card.",
      "They're identity cards."
     ]
    ]
   },
   "examples": [
    [
     "It's a charger.",
     "Bu bir şarj aleti."
    ],
    [
     "It's an email.",
     "Bu bir e-posta."
    ],
    [
     "It's a university.",
     "Bu bir üniversite."
    ],
    [
     "Look at the board.",
     "Tahtaya bak."
    ]
   ]
  },
  {
   "id": "g2",
   "title": "Plural nouns (çoğul isimler)",
   "tr": "Çoğul için çoğu isme <b>-s</b> eklenir. <b>ch, sh, s, x</b> ile bitenlere <b>-es</b>, <b>ünsüz + y</b> ile bitenlerde y düşer ve <b>-ies</b> gelir (key gibi ünlü + y: keys). İki kelimeli isimlerde -s ikinci kelimeye eklenir (credit cards). <b>-es</b> eki /ɪz/ olarak okunur: watches, classes, sandwiches. Düzensiz çoğullar ezberlenir.",
   "table": {
    "head": [
     "Kural",
     "Tekil",
     "Çoğul"
    ],
    "rows": [
     [
      "-s",
      "book",
      "books"
     ],
     [
      "-es",
      "watch / box / class",
      "watches / boxes / classes"
     ],
     [
      "ünsüz + y → -ies",
      "country / diary",
      "countries / diaries"
     ],
     [
      "düzensiz",
      "man / woman",
      "men / women"
     ],
     [
      "düzensiz",
      "child / person",
      "children / people"
     ]
    ]
   },
   "examples": [
    [
     "They're photos.",
     "Bunlar fotoğraflar."
    ],
    [
     "There are eight men and six women.",
     "Sekiz erkek ve altı kadın var."
    ],
    [
     "I have two children.",
     "İki çocuğum var."
    ]
   ]
  },
  {
   "id": "g3",
   "title": "Adjectives (sıfatlar)",
   "tr": "Sıfat isimden <b>önce</b> gelir ve çoğul isimden önce değişmez: a beautiful picture, blue jeans (NOT blues jeans). Sıfat ünlüyle başlıyorsa <b>an</b> kullanırız: an old book. Sıfatı <b>be</b> fiilinden sonra da kullanırız: My car is new. Soruda sıra: Is your car new?",
   "table": {
    "head": [
     "Yanlış",
     "Doğru"
    ],
    "rows": [
     [
      "It's a house big.",
      "It's a big house."
     ],
     [
      "They're magazines old.",
      "They're old magazines."
     ],
     [
      "They're youngs women.",
      "They're young women."
     ],
     [
      "It's a watch expensive.",
      "It's an expensive watch."
     ]
    ]
   },
   "examples": [
    [
     "It's a very big city.",
     "Çok büyük bir şehir."
    ],
    [
     "Is your car new?",
     "Araban yeni mi?"
    ],
    [
     "They're dirty windows.",
     "Bunlar kirli pencereler."
    ]
   ]
  },
  {
   "id": "g4",
   "title": "very / really / quite",
   "tr": "Sıfatın önünde derece belirtmek için kullanılır. <b>very</b> ve <b>really</b> “çok”, <b>quite</b> “oldukça” demektir (very'den daha zayıf). Olumsuzda <b>isn't very</b> “pek … değil” anlamına gelir.",
   "table": {
    "head": [
     "Cümle",
     "Anlam"
    ],
    "rows": [
     [
      "He's very (really) tall.",
      "Çok uzun."
     ],
     [
      "He's quite tall.",
      "Oldukça uzun."
     ],
     [
      "He isn't very tall.",
      "Pek uzun değil."
     ]
    ]
   },
   "examples": [
    [
     "We're really tired.",
     "Gerçekten yorgunuz."
    ],
    [
     "It's a very big city.",
     "Çok büyük bir şehir."
    ],
    [
     "My watch is quite expensive.",
     "Saatim oldukça pahalı."
    ]
   ]
  },
  {
   "id": "g5",
   "title": "Imperatives (emir cümleleri)",
   "tr": "Emir cümlesi <b>fiilin yalın hâli</b> ile kurulur; özne (you) kullanılmaz. Olumsuz: <b>Don't + fiil</b>. Nazik olmak için <b>please</b> eklenir. <b>be + sıfat</b> da sık kullanılır: Be quiet. Daha kibar bir alternatif: <b>Can you + fiil …?</b>",
   "table": {
    "head": [
     "Olumlu (+)",
     "Olumsuz (–)"
    ],
    "rows": [
     [
      "Open the door.",
      "Don't close the door."
     ],
     [
      "Look at the board.",
      "Don't read the text."
     ],
     [
      "Be quiet, please.",
      "Don't be late."
     ]
    ]
   },
   "examples": [
    [
     "Turn right.",
     "Sağa dön."
    ],
    [
     "Open the door, please.",
     "Lütfen kapıyı aç."
    ],
