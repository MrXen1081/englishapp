 "grammar": [
  {
   "id": "g1",
   "title": "Countable / uncountable nouns, a/an, some/any (9A)",
   "tr": "İsimler <b>sayılabilir</b> (apple – apples) veya <b>sayılamaz</b> (rice, meat, butter) olabilir. Sayılamaz isimler genelde tekil kabul edilir ve çoğul olmaz (<i>two rices</i> ✗). Tekil sayılabilir isimle <b>a / an</b> kullanılır. <b>some</b> olumlu cümlede çoğul sayılabilir ve sayılamaz isimlerle; <b>any</b> olumsuz ve soru cümlesinde kullanılır. Birine bir şey ikram ederken veya isterken soruda da <b>some</b> kullanılır: <i>Can I have some sugar? Would you like some coffee?</i> Bazı isimler iki türlü kullanılır: <i>an ice cream</i> (bir dondurma) / <i>some ice cream</i>.",
   "table": {
    "head": [
     "Sayılabilir (tekil / çoğul)",
     "Sayılamaz"
    ],
    "rows": [
     [
      "an apple, three apples, a tomato",
      "rice, meat, butter"
     ],
     [
      "We need some apples. / We need a tomato.",
      "We need some butter."
     ],
     [
      "We don't need any apples.",
      "We don't need any rice."
     ],
     [
      "Do we need any oranges? / an orange?",
      "Do we need any cheese?"
     ]
    ]
   },
   "examples": [
    [
     "We need some butter.",
     "Biraz tereyağına ihtiyacımız var."
    ],
    [
     "There isn't any milk in the fridge.",
     "Buzdolabında hiç süt yok."
    ],
    [
     "Can I have some sugar, please?",
     "Biraz şeker alabilir miyim?"
    ],
    [
     "I had an egg for breakfast.",
     "Kahvaltıda bir yumurta yedim."
    ]
   ]
  },
  {
   "id": "g2",
   "title": "Quantifiers: how much / how many, a lot of (9B)",
   "tr": "<b>How much…?</b> sayılamaz, <b>How many…?</b> çoğul sayılabilir isimlerle sorulur. Miktar: <b>a lot (of)</b> çok, <b>quite a lot (of)</b> orta, <b>a little</b> (sayılamaz) / <b>a few</b> (çoğul) az, <b>not much</b> (sayılamaz) / <b>not many</b> (çoğul) çok değil, <b>not any</b> (kısa cevapta <b>None</b>) hiç. Olumlu cümlede genelde <b>a lot of</b>, olumsuz ve soruda <b>much / many</b> tercih edilir. Kısa cevapta <i>of</i> kullanılmaz: <i>A lot. / Quite a lot.</i> (<i>Quite a lot of.</i> ✗). <i>A lot of</i> ve <i>lots of</i> aynı anlamdadır.",
   "table": {
    "head": [
     "Sayılamaz",
     "Çoğul sayılabilir"
    ],
    "rows": [
     [
      "How much sugar do you eat?",
      "How many sweets do you eat?"
     ],
     [
      "A lot. / Quite a lot.",
      "A lot. / Quite a lot."
     ],
     [
      "A little. / Not much.",
      "A few. / Not many."
     ],
     [
      "None. I don't eat any sugar.",
      "None. I don't eat any sweets."
     ]
    ]
   },
   "examples": [
    [
     "I eat a lot of sugar.",
     "Çok şeker yerim."
    ],
    [
     "I don't drink much water.",
     "Fazla su içmem."
    ],
    [
     "How many sweets do you eat? A few.",
     "Kaç şekerleme yersin? Birkaç tane."
    ],
    [
     "I have a little cereal for breakfast.",
     "Kahvaltıda biraz mısır gevreği yerim."
    ]
   ]
  },
  {
   "id": "g3",
   "title": "Comparative adjectives (9C)",
   "tr": "İki şeyi, kişiyi vs. karşılaştırmak için <b>sıfat + -er / more + sıfat + than</b> kullanılır. Tek heceli sıfatlara <b>-er</b> (old → older; <i>-e</i> ile bitiyorsa <b>-r</b>: nice → nicer). Tek ünlü + tek ünsüzle bitenler ünsüzü ikiler (big → bigger). Bir veya iki heceli ve <b>-y</b> ile bitenlerde y → <b>-ier</b> (dry → drier, healthy → healthier). <b>-ed</b> ile bitenler ve iki veya daha çok heceli sıfatlar <b>more</b> alır (more expensive, more tired, more famous). Düzensizler: good → better, bad → worse, far → further.",
   "table": {
    "head": [
     "Kural",
     "Örnek"
    ],
    "rows": [
     [
      "1 hece: + -er",
      "old → older, cheap → cheaper"
     ],
     [
      "1 ünlü + 1 ünsüz: ünsüz ikilenir",
      "big → bigger, hot → hotter"
     ],
     [
      "-y ile biten: y → -ier",
      "dry → drier, healthy → healthier"
     ],
     [
      "2+ hece (ve -ed): more + sıfat",
      "more expensive, more tired"
     ],
     [
      "Düzensiz",
      "good → better, bad → worse, far → further"
     ]
    ]
   },
   "examples": [
    [
     "Stonehenge is older than the Pyramids.",
     "Stonehenge, Piramitlerden daha eskidir."
    ],
    [
     "Brazil is wetter than Ireland.",
     "Brezilya İrlanda'dan daha yağışlıdır."
    ],
    [
     "New York is more expensive than Paris.",
     "New York Paris'ten daha pahalıdır."
    ],
    [
     "The traffic is always worse in the evening.",
     "Trafik akşamları hep daha kötüdür."
    ]
   ]
  }
 ],
