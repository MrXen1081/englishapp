 "grammar": [
  {
   "id": "g1",
   "title": "Superlative adjectives (10A)",
   "tr": "Bir grup içinde <b>en</b>… olanı söylemek için <b>the + sıfat + -est / the most + sıfat</b> kullanılır. Tek heceli sıfatlara <b>-est</b> (cold → the coldest; <i>-e</i> ile bitiyorsa <b>-st</b>: nice → the nicest). Tek ünlü + tek ünsüzle bitenlerde ünsüz ikilenir (big → the biggest). Ünsüz + <b>-y</b> ile bitenlerde y → <b>-iest</b> (sunny → the sunniest). <b>-ed</b> ile bitenler ve iki veya daha çok heceli sıfatlar <b>the most</b> alır. Düzensizler: good → the best, bad → the worst, far → the furthest. Üstünlük derecesinden sonra yer için <b>in</b> kullanılır (<b>of</b> değil): <i>the longest road in the world.</i>",
   "table": {
    "head": [
     "Sıfat",
     "Üstünlük"
    ],
    "rows": [
     [
      "cold, big, hot",
      "the coldest, the biggest, the hottest"
     ],
     [
      "dry, sunny",
      "the driest, the sunniest"
     ],
     [
      "bored, stressed",
      "the most bored, the most stressed"
     ],
     [
      "dangerous, expensive",
      "the most dangerous, the most expensive"
     ],
     [
      "good, bad, far",
      "the best, the worst, the furthest"
     ]
    ]
   },
   "examples": [
    [
     "It's the oldest bridge in the world.",
     "Dünyadaki en eski köprü."
    ],
    [
     "She's the best student in the class.",
     "Sınıftaki en iyi öğrenci o."
    ],
    [
     "Monday is the worst day of the week.",
     "Pazartesi haftanın en kötü günüdür."
    ],
    [
     "The tallest building in New York.",
     "New York'taki en yüksek bina."
    ]
   ]
  },
  {
   "id": "g2",
   "title": "be going to (plans), future time expressions (10B)",
   "tr": "Gelecek planlarını anlatmak için <b>be (am / is / are) + going to + yalın fiil</b> kullanılır. Genelde <b>tomorrow, next week, next month, next year</b> gibi gelecek zaman ifadeleriyle birlikte gelir. Olumsuz: <b>be + not + going to</b> (I'm not going to…, He isn't going to…). Soru: <b>Am I / Are you / Is he going to…?</b>; kısa cevap: <i>Yes, I am. / No, he isn't.</i> Özne ve be kısaltılır: I'm, you're, he's, we're, they're.",
   "table": {
    "head": [
     "Olumlu / olumsuz",
     "Soru"
    ],
    "rows": [
     [
      "I'm going to have a holiday next summer.",
      "Am I going to have a holiday?"
     ],
     [
      "You're going to study English tonight.",
      "Are you going to study English tonight?"
     ],
     [
      "He's not (isn't) going to study English.",
      "Is he going to study English? Yes, he is. / No, he isn't."
     ],
     [
      "We aren't going to fly to Paris.",
      "Are they going to fly to Paris? Yes, they are."
     ]
    ]
   },
   "examples": [
    [
     "I'm going to have a holiday next month.",
     "Gelecek ay tatile çıkacağım."
    ],
    [
     "I'm not going to study English.",
     "İngilizce çalışmayacağım."
    ],
    [
     "Are you going to fly to Paris?",
     "Paris'e uçakla mı gideceksin?"
    ],
    [
     "What are you going to do tonight?",
     "Bu gece ne yapacaksın?"
    ]
   ]
  },
  {
   "id": "g3",
   "title": "be going to (predictions) (10C)",
   "tr": "<b>be going to + yalın fiil</b> ile <b>tahmin</b> de yapılır: şu an gördüğümüz veya düşündüğümüz bir şeyin gelecekte olacağını söyleriz. <i>I think it's going to rain.</i> <i>You're going to be rich.</i> <i>I'm sure they're going to win.</i> Olumsuz ve soru yapısı plan anlamındakiyle aynıdır: <i>It isn't going to rain. Is it going to rain?</i> <b>be</b> ve <b>to</b>'yu unutma: <i>You're going fall</i> ✗ → <i>You're going to fall</i> ✓.",
   "table": {
    "head": [
     "Olumlu",
     "Olumsuz / soru"
    ],
    "rows": [
     [
      "It's going to rain.",
      "It isn't going to rain. / Is it going to rain?"
     ],
     [
      "You're going to be rich.",
      "You aren't going to be rich."
     ],
     [
      "They're going to win.",
      "Are they going to win?"
     ]
    ]
   },
   "examples": [
    [
     "I think it's going to rain.",
     "Sanırım yağmur yağacak."
    ],
    [
     "Be careful! You're going to fall.",
     "Dikkat et! Düşeceksin."
    ],
    [
     "I'm sure they're going to win.",
     "Eminim kazanacaklar."
    ],
    [
     "She's going to have a baby next month.",
     "Gelecek ay bebeği olacak."
    ]
   ]
  }
 ],
