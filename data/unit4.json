 "grammar": [
  {
   "id": "g1",
   "title": "Iyelik 's (possessive 's)",
   "tr": "Aile ve sahiplik için <b>kişi + 's</b> kullanılır: Rihanna's brother. 's, <b>of</b> anlamı taşır. İsim <b>s</b> ile bitiyorsa da 's eklenebilir: James's laptop.",
   "table": {
    "head": [
     "Kural",
     "Örnek"
    ],
    "rows": [
     [
      "tekil isim + 's",
      "my brother's girlfriend"
     ],
     [
      "s ile biten isim + 's",
      "James's laptop"
     ]
    ]
   },
   "examples": [
    [
     "He's Rihanna's brother.",
     "O, Rihanna'nın erkek kardeşi."
    ],
    [
     "It's James's laptop.",
     "Bu James'in dizüstü bilgisayarı."
    ]
   ]
  },
  {
   "id": "g2",
   "title": "Çoğul isimlerde 's / s'",
   "tr": "Düzenli çoğul isimlerde (s ile biten) kesme işareti <b>s'den sonra</b> gelir: my parents' car. Düzensiz çoğul isimlerde (children, men) <b>'s</b> kullanılır: the children's room, men's clothes.",
   "table": {
    "head": [
     "Çoğul türü",
     "Örnek"
    ],
    "rows": [
     [
      "düzenli (-s)",
      "my parents' car"
     ],
     [
      "düzensiz",
      "the children's room"
     ]
    ]
   },
   "examples": [
    [
     "It's my parents' car.",
     "Bu, ailemin arabası."
    ],
    [
     "The children's room is untidy.",
     "Çocukların odası dağınık."
    ]
   ]
  },
  {
   "id": "g3",
   "title": "Whose...? ve kişi + 's",
   "tr": "Sahiplik sormak için <b>Whose...?</b> kullanılır. İki biçimde sorulabilir: Whose is this bag? / Whose bag is this? Cevap: It's Maria's bag. / It's Maria's.",
   "table": {
    "head": [
     "Soru",
     "Cevap"
    ],
    "rows": [
     [
      "Whose is this bag?",
      "It's Maria's."
     ],
     [
      "Whose bag is this?",
      "It's Maria's bag."
     ]
    ]
   },
   "examples": [
    [
     "Whose charger is this?",
     "Bu kimin şarj aleti?"
    ],
    [
     "Whose are the glasses?",
     "Gözlükler kimin?"
    ]
   ]
  },
  {
   "id": "g4",
   "title": "Şeylerde 's kullanılmaz",
   "tr": "Nesneler için genellikle <b>'s</b> kullanılmaz; <b>of</b> ya da isim tamlaması kullanılır: the end of the film (the film's end değil), the city centre (the city's centre değil).",
   "table": {
    "head": [
     "Doğru",
     "Yanlış"
    ],
    "rows": [
     [
      "the end of the film",
      "the film's end"
     ],
     [
      "the city centre",
      "the city's centre"
     ],
     [
      "the end of the class",
      "the class's end"
     ]
    ]
   },
   "examples": [
    [
     "The end of the film is fantastic.",
     "Filmin sonu harika."
    ],
    [
     "I live in the city centre.",
     "Şehir merkezinde yaşıyorum."
    ]
   ]
  },
  {
   "id": "g5",
   "title": "'s = is mi, iyelik mi?",
   "tr": "<b>'s</b> iki şey olabilir: <b>Maria's mother</b> ('s = of Maria, iyelik) ve <b>Maria's Spanish</b> ('s = is). <b>Whose</b> = kimin (Whose is this bag?), <b>Who's</b> = Who is (Who's that girl?). İkisi de /huːz/ okunur.",
   "table": {
    "head": [
     "Biçim",
     "Anlam"
    ],
    "rows": [
     [
      "Maria's mother",
      "'s = of Maria"
     ],
     [
      "Maria's Spanish",
      "'s = is"
     ],
     [
      "Whose bag is this?",
      "kimin"
     ],
     [
      "Who's that girl?",
      "kim (Who is)"
     ]
    ]
   },
   "examples": [
    [
     "Who's that girl? — She's my sister.",
     "O kız kim? — Kız kardeşim."
    ],
    [
     "Whose is this bag? — It's Jack's.",
     "Bu çanta kimin? — Jack'in."
    ]
   ]
  },
  {
   "id": "g6",
   "title": "Zaman edatları: in / on / at",
   "tr": "<b>in</b>: günün bölümleri (the morning), mevsimler, aylar, yıllar. <b>on</b>: günler ve tarihler (Monday, 1 January). <b>at</b>: saat (three o'clock), night, the weekend, bayramlar (Christmas), midday / midnight, lunchtime.",
   "table": {
    "head": [
     "in",
     "on",
     "at"
    ],
    "rows": [
     [
      "the morning / the summer / December / 2018",
      "Monday / 1 January / Monday morning",
      "three o'clock / night / the weekend / Christmas"
     ]
    ]
   },
   "examples": [
    [
     "I have a shower in the morning.",
     "Sabahları duş alırım."
    ],
    [
     "We have English classes on Tuesdays.",
     "Salı günleri İngilizce dersimiz var."
    ],
    [
     "They go on holiday in August.",
     "Ağustosta tatile giderler."
    ]
   ]
  },
  {
   "id": "g7",
   "title": "Yer ve hareket edatları: at / in / to",
   "tr": "<b>at</b> + work, home, school, university. <b>in</b> + diğer yerler (a flat, an office, a room). restaurant, cinema gibi bazı yerlerde in ya da at kullanılabilir. Hareket için <b>to</b>: go to the gym. <b>home</b> önünde to kullanılmaz: go home.",
   "table": {
    "head": [
     "Kullanım",
     "Örnek"
    ],
    "rows": [
     [
      "at + work/home/school",
      "He has lunch at work."
     ],
     [
      "in + diğer yerler",
      "He works in an office."
     ],
     [
      "to + hareket",
      "She goes to the gym."
     ],
     [
      "to yok",
      "go home"
     ]
    ]
   },
   "examples": [
    [
     "Jack isn't at home.",
     "Jack evde değil."
    ],
    [
     "I go to the gym on Tuesdays.",
     "Salı günleri spor salonuna giderim."
    ]
   ]
  },
  {
   "id": "g8",
   "title": "Sıklık zarflarının yeri",
   "tr": "always, usually, often, sometimes, hardly ever, never sıklık zarfları <b>ana fiilden önce</b> gelir. Olumsuz cümlede don't / doesn't ile fiil arasına girer. <b>be</b> fiilinden <b>sonra</b> gelir; be'li soruda öznenin arkasına gelir. hardly ever ve never olumlu fiille kullanılır.",
   "table": {
    "head": [
     "Durum",
     "Örnek"
    ],
    "rows": [
     [
      "ana fiilden önce",
      "I always watch TV in the evening."
     ],
     [
      "olumsuzda",
      "She doesn't often go to bed late."
     ],
     [
      "be'den sonra",
      "They're hardly ever late."
     ],
     [
      "be'li soru",
      "Are you usually in this classroom?"
     ]
    ]
   },
   "examples": [
    [
     "She sometimes does sport.",
     "Bazen spor yapar."
    ],
    [
     "He's never stressed.",
     "O asla stresli değil."
    ]
   ]
  },
  {
   "id": "g9",
   "title": "Sıklık ifadeleri",
   "tr": "every day, twice a week, three times a day, once a month gibi sıklık ifadeleri genellikle <b>cümlenin ya da fiil öbeğinin sonunda</b> yer alır. Sıklığı sormak için <b>How often...?</b> kullanılır.",
   "table": {
    "head": [
     "Soru",
