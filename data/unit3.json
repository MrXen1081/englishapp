 "grammar": [
  {
   "id": "g1",
   "title": "Present simple + (olumlu)",
   "tr": "Genel doğrular ve alışkanlıklar için <b>present simple</b> kullanılır. I / you / we / they ile fiil yalın halde kalır; <b>he / she / it</b> ile fiile <b>-s</b> gelir.",
   "table": {
    "head": [
     "Özne",
     "Fiil"
    ],
    "rows": [
     [
      "I / You / We / They",
      "work"
     ],
     [
      "He / She / It",
      "works"
     ]
    ]
   },
   "examples": [
    [
     "I speak English.",
     "İngilizce konuşurum."
    ],
    [
     "My mother cooks fantastic food.",
     "Annem harika yemekler pişirir."
    ],
    [
     "They live in a flat.",
     "Bir apartman dairesinde yaşıyorlar."
    ]
   ]
  },
  {
   "id": "g2",
   "title": "Present simple − (olumsuz)",
   "tr": "Olumsuz için <b>don't</b> (do not) ya da <b>doesn't</b> (does not) + fiilin yalın hali kullanılır. <b>doesn't</b> ile fiile -s gelmez: He doesn't work (He doesn't works değil).",
   "table": {
    "head": [
     "Özne",
     "Olumsuz"
    ],
    "rows": [
     [
      "I / You / We / They",
      "don't work"
     ],
     [
      "He / She / It",
      "doesn't work"
     ]
    ]
   },
   "examples": [
    [
     "I don't drink tea.",
     "Çay içmem."
    ],
    [
     "He doesn't play the guitar.",
     "Gitar çalmaz."
    ],
    [
     "We don't have a garden.",
     "Bahçemiz yok."
    ]
   ]
  },
  {
   "id": "g3",
   "title": "he / she / it yazım kuralları",
   "tr": "he / she / it ile yazım, çoğul yapma kurallarıyla aynıdır. Çoğu fiile <b>-s</b>; <b>ch, sh, s, x, o</b> ile bitenlere <b>-es</b>; <b>ünsüz + y</b> ile bitenlerde <b>-ies</b> gelir. Düzensizler: have → <b>has</b>, go → <b>goes</b>, do → <b>does</b>. -es sonu /ɪz/ okunur: watches, finishes, closes, uses.",
   "table": {
    "head": [
     "Kural",
     "I / you / they",
     "he / she / it"
    ],
    "rows": [
     [
      "-s",
      "work / play / live",
      "works / plays / lives"
     ],
     [
      "-es",
      "watch / finish / go / do",
      "watches / finishes / goes / does"
     ],
     [
      "ünsüz + y → -ies",
      "study",
      "studies"
     ],
     [
      "düzensiz",
      "have",
      "has"
     ]
    ]
   },
   "examples": [
    [
     "She watches TV.",
     "O televizyon izler."
    ],
    [
     "Amira studies history.",
     "Amira tarih okuyor."
    ],
    [
     "He has four children.",
     "Onun dört çocuğu var."
    ]
   ]
  },
  {
   "id": "g4",
   "title": "Present simple ? (soru)",
   "tr": "Soru için <b>do</b> (he / she / it ile <b>does</b>) + özne + fiilin yalın hali kullanılır (sıra: Aux – Subject – Infinitive). Kısa cevaplar: Yes, I <b>do</b>. / No, she <b>doesn't</b>. <b>do</b> hem yardımcı fiil hem de asıl fiil olabilir: Do you do housework?",
   "table": {
    "head": [
     "Soru",
     "Kısa cevap"
    ],
    "rows": [
     [
      "Do you work at weekends?",
      "Yes, I do. / No, I don't."
     ],
     [
      "Does she work long hours?",
      "Yes, she does. / No, she doesn't."
     ],
     [
      "Do they wear a uniform?",
      "Yes, they do. / No, they don't."
     ]
    ]
   },
   "examples": [
    [
     "Do you live in New York?",
     "New York'ta mı yaşıyorsun?"
    ],
    [
     "Does he travel to different countries?",
     "Farklı ülkelere seyahat eder mi?"
    ],
    [
     "I do my homework in the evening.",
     "Ödevimi akşamları yaparım."
    ]
   ]
  },
  {
   "id": "g5",
   "title": "Meslekler: What do you do? / a, an, at, in, for",
   "tr": "Meslek sormak için <b>What do you do?</b> / <b>What does she do?</b> kullanılır; cevapta ünlüyle başlayan mesleklerde <b>an</b> (an engineer), diğerlerinde <b>a</b> (a nurse) gelir. Çalışılan yer için <b>work in</b> (a factory, an office), <b>work for</b> (a company), <b>study at</b> (university) kullanılır. <b>retired</b> ve <b>unemployed</b> önünde a/an kullanılmaz.",
   "table": {
    "head": [
     "Kullanım",
     "Örnek"
    ],
    "rows": [
     [
      "Meslek sormak",
      "What do you do?"
     ],
     [
      "a / an",
      "a nurse / an engineer"
     ],
     [
      "çalıştığı yer",
      "work in a factory / for a company"
     ],
     [
      "okuduğu yer",
      "study at university"
     ]
    ]
   },
   "examples": [
    [
     "What does she do? — She's a waiter.",
     "O ne iş yapıyor? — Garson."
    ],
    [
     "We work for a Japanese company.",
     "Japon bir şirkette çalışıyoruz."
    ],
    [
     "My grandparents are retired.",
     "Büyükanne ve büyükbabam emekli."
    ]
   ]
  },
  {
   "id": "g6",
   "title": "Soruda kelime sırası (be ve do / does)",
   "tr": "<b>be</b> ile sorularda be öznenin önüne gelir: Question word + be + subject. Diğer fiillerle sıra <b>QuASI</b>'dir: <b>Qu</b>estion word – <b>A</b>uxiliary – <b>S</b>ubject – <b>I</b>nfinitive.",
   "table": {
    "head": [
     "be ile",
     "do / does ile"
    ],
    "rows": [
     [
      "Is she from Spain?",
      "Do you live near here?"
     ],
     [
      "Where is your office?",
      "Where does he live?"
     ],
     [
      "How old is she?",
      "How many children do they have?"
     ]
    ]
   },
   "examples": [
    [
     "How old are you?",
     "Kaç yaşındasın?"
    ],
    [
     "What kind of music does she like?",
     "Ne tür müzik seviyor?"
    ],
    [
     "Where is your teacher from?",
     "Öğretmeniniz nereli?"
    ]
   ]
  },
  {
   "id": "g7",
   "title": "Soru kelimeleri",
   "tr": "<b>Where</b> (yer), <b>When</b> (zaman), <b>Who</b> (kim), <b>Why</b> (neden; cevap <i>because</i>), <b>Which</b> (iki ya da birkaç seçenek arasından), <b>How many</b> (sayı), <b>What kind of</b> (tür), <b>What</b> (ne).",
   "table": {
    "head": [
     "Soru",
     "Cevap"
    ],
    "rows": [
     [
      "Where do you work?",
      "In a factory."
     ],
     [
      "When do you go to the cinema?",
      "At weekends."
     ],
     [
      "What kind of films do you like?",
      "Action films."
     ],
     [
      "How many children do you have?",
      "Two."
     ],
     [
