 "grammar": [
  {
   "id": "g1",
   "title": "Object pronouns: me, you, him...",
   "tr": "<b>Subject pronoun</b> fiilden önce (eylemi yapan), <b>object pronoun</b> fiilden veya edattan sonra gelir (eylemi alan): <b>I → me, you → you, he → him, she → her, it → it, we → us, they → them</b>. Edatlardan sonra da (with, to, from, for…) object pronoun kullanılır: <i>I'm in love with her</i> (with she değil).",
   "table": {
    "head": [
     "Subject",
     "Object"
    ],
    "rows": [
     [
      "I",
      "me"
     ],
     [
      "you",
      "you"
     ],
     [
      "he",
      "him"
     ],
     [
      "she",
      "her"
     ],
     [
      "it",
      "it"
     ],
     [
      "we",
      "us"
     ],
     [
      "they",
      "them"
     ]
    ]
   },
   "examples": [
    [
     "I love you.",
     "Seni seviyorum."
    ],
    [
     "She doesn't love him.",
     "O onu sevmiyor."
    ],
    [
     "Give this money to him.",
     "Bu parayı ona ver."
    ],
    [
     "Wait for us!",
     "Bizi bekle!"
    ]
   ]
  },
  {
   "id": "g2",
   "title": "like + verb + -ing",
   "tr": "<b>love, like, don't mind, hate</b> (ayrıca enjoy, prefer) fiillerinden sonra <b>fiil + -ing</b> gelir. Yazım: fiile <b>-ing</b> eklenir (cook → cooking); sessizle biten fiillerde <b>e düşer</b> (dance → dancing); <b>tek ünlü + tek ünsüz</b> ile biten fiillerde ünsüz <b>ikilenir</b> (run → running, swim → swimming); study → studying, play → playing.",
   "table": {
    "head": [
     "Anlam",
     "Örnek"
    ],
    "rows": [
     [
      "love",
      "I love shopping."
     ],
     [
      "like",
      "I like going to the cinema."
     ],
     [
      "don't mind",
      "I don't mind getting up early."
     ],
     [
      "don't like",
      "I don't like doing housework."
     ],
     [
      "hate",
      "I hate driving at night."
     ]
    ]
   },
   "examples": [
    [
     "Max hates dancing at parties.",
     "Max partilerde dans etmekten nefret eder."
    ],
    [
     "Tess doesn't like swimming in the sea.",
     "Tess denizde yüzmeyi sevmez."
    ],
    [
     "I enjoy watching football on TV.",
     "TV'de futbol izlemekten hoşlanırım."
    ]
   ]
  },
  {
   "id": "g3",
   "title": "be or do?",
   "tr": "<b>be</b> ana fiil olarak (<i>I'm Ed. Are you Polish?</i>) ve present continuous için yardımcı fiil olarak (<i>I'm driving. Is it raining?</i>) kullanılır. <b>do / does</b> ana fiil olarak (<i>I'm doing my homework</i> → <i>do</i> = yapmak) ve present simple soru/olumsuzunda yardımcı olarak (<i>Do you speak English? He doesn't like jazz.</i>) kullanılır. Kural: fiilin sonunda <b>-ing</b> varsa <b>be</b> (Are you listening?), yalın fiil varsa <b>do</b> (Do you play?).",
   "table": {
    "head": [
     "be",
     "do / does"
    ],
    "rows": [
     [
      "Are you Polish?",
      "Do you speak English?"
     ],
     [
      "They aren't working today.",
      "They don't have children."
     ],
     [
      "Is it raining?",
      "Where does your father work?"
     ]
    ]
   },
   "examples": [
    [
     "What are you listening to?",
     "Ne dinliyorsun?"
    ],
    [
     "Do you play an instrument?",
     "Bir enstrüman çalıyor musun?"
    ],
    [
     "Laura isn't dancing at the moment.",
     "Laura şu anda dans etmiyor."
    ]
   ]
  }
 ],
