 "grammar": [
  {
   "id": "g1",
   "title": "Verb be: olumlu (+) — I am / you are…",
   "tr": "<b>be</b> fiili Türkçedeki “-im, -sin, -dir” ekleri gibidir: biri/bir şey kim, ne, nereli olduğunu söyler. Konuşmada genelde kısaltma kullanılır.",
   "table": {
    "head": [
     "Özne",
     "Tam biçim",
     "Kısaltma"
    ],
    "rows": [
     [
      "I",
      "I am",
      "I'm"
     ],
     [
      "you",
      "you are",
      "you're"
     ],
     [
      "he",
      "he is",
      "he's"
     ],
     [
      "she",
      "she is",
      "she's"
     ],
     [
      "it",
      "it is",
      "it's"
     ],
     [
      "we",
      "we are",
      "we're"
     ],
     [
      "they",
      "they are",
      "they're"
     ]
    ]
   },
   "examples": [
    [
     "I'm Lola.",
     "Ben Lola'yım."
    ],
    [
     "She's from Italy.",
     "O İtalya'lı."
    ],
    [
     "We're in my English class.",
     "Biz İngilizce sınıfımızdayız."
    ],
    [
     "It's Thursday.",
     "Bugün Perşembe."
    ]
   ]
  },
  {
   "id": "g2",
   "title": "Subject pronouns (özne zamirleri)",
   "tr": "Cümlenin öznesi olan kelimelerdir. <b>I</b> daima büyük yazılır. <b>he</b> erkek, <b>she</b> kadın, <b>it</b> nesne/hayvan içindir; İngilizcede “o” için üç farklı zamir vardır. Özne cümlede yazılmak zorundadır.",
   "table": {
    "head": [
     "Tekil",
     "Çoğul"
    ],
    "rows": [
     [
      "I (ben)",
      "we (biz)"
     ],
     [
      "you (sen)",
      "you (siz)"
     ],
     [
      "he / she / it (o)",
      "they (onlar)"
     ]
    ]
   },
   "examples": [
    [
     "This is Mark. He's your teacher.",
     "Bu Mark. O senin öğretmenin."
    ],
    [
     "Alex and Beth are students. They're at university.",
     "Alex ve Beth öğrenci. Onlar üniversitede."
    ]
   ]
  },
  {
   "id": "g3",
   "title": "Verb be: olumsuz (–) ve soru (?)",
   "tr": "<b>Olumsuz:</b> be fiilinden sonra <b>not</b> gelir (I'm not, he isn't, we aren't). <b>Soru:</b> be fiili özneden önce gelir. <b>Kısa cevap:</b> Yes, I am. / No, I'm not. (Yes, I'm yazılmaz!) Soru kelimeleri: What? Where? How old?",
   "table": {
    "head": [
     "Olumsuz",
     "Soru",
     "Kısa cevap"
    ],
    "rows": [
     [
      "I'm not",
      "Am I…?",
      "Yes, I am. / No, I'm not."
     ],
     [
      "you aren't",
      "Are you…?",
      "Yes, you are. / No, you aren't."
     ],
     [
      "he/she/it isn't",
      "Is he…?",
      "Yes, he is. / No, he isn't."
     ],
     [
      "we aren't",
      "Are we…?",
      "Yes, we are. / No, we aren't."
     ],
     [
      "they aren't",
      "Are they…?",
      "Yes, they are. / No, they aren't."
     ]
    ]
   },
   "examples": [
    [
     "Are you from Spain?",
     "İspanya'lı mısın?"
    ],
    [
     "She isn't English. She's Scottish.",
     "O İngiliz değil. İskoç."
    ],
    [
     "What's your name?",
     "Adın ne?"
    ],
    [
     "Where's she from?",
     "O nereli?"
    ],
    [
     "No, I'm not American.",
     "Hayır, Amerikalı değilim."
    ]
   ]
  },
  {
   "id": "g4",
   "title": "Possessive adjectives (iyelik sıfatları)",
   "tr": "İyelik sıfatları Türkçedeki “-im, -in, -i” iyelik eklerinin karşılığıdır, ismin <b>önüne</b> gelir: my phone = telefonum. <b>Dikkat:</b> you (sen) ≠ your (senin). <b>its</b> (kesme işaretsiz) = “onun” (nesne için); it's = it is.",
   "table": {
    "head": [
     "Özne",
     "İyelik sıfatı"
    ],
    "rows": [
     [
      "I",
